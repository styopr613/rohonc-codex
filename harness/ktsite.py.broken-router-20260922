def code_files(out):
    """Publish the programs themselves as plain text, and read each one's first
    docstring line so the listing says what it does. Served as .txt because the
    static handler has no rule for .py, and a download prompt is not a link."""
    src = os.path.join(ROOT, "harness")
    os.makedirs(os.path.join(out, "code"), exist_ok=True)
    seen, listed = {}, set()
    for fn in sorted(os.listdir(src)):
        if not fn.endswith(".py") or ".pre-" in fn:
            continue
        txt = read(os.path.join(src, fn))
        m = re.match(r'\s*"""(.*?)(?:\n|""")', txt, re.S)
        one = " ".join((m.group(1) if m else "").split())
        one = re.sub(r"^%s\s*--\s*" % re.escape(fn), "", one)
        open(os.path.join(out, "code", fn + ".txt"), "w", encoding="utf-8").write(txt)
        seen[fn] = one or "no description"
    groups = []
    for title, names in CODE_GROUPS:
        items = [(n, seen[n]) for n in names if n in seen]
        listed.update(n for n, _ in items)
        if items:
            groups.append((title, items))
    rest = [(n, d) for n, d in sorted(seen.items()) if n not in listed]
    if rest:
        groups.append(("Everything else", rest))
    return groups


